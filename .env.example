# ASI:One API Configuration
ASI_KEY=your_asi_api_key_here
ASI_MODEL=asi1-mini

# Demo Mode Configuration
# Options: simulation (default) or live
# simulation: Uses deterministic vendor responses (no network required)
# live: Uses real uAgents Chat Protocol communication
DEMO_MODE=simulation

# Vendor Agent Configuration (required for live mode)
# Format: agent1q...@https://127.0.0.1:8001 or Agentverse address
VENDOR_AGENT_ADDRESS=

# Approval Gate Configuration
APPROVAL_CAP=1000
CONFIDENCE_THRESHOLD=0.7
